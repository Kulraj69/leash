# Synthetic RPC data unless explicitly set to 1.
NEAR_LIVE=0
NEAR_RPC_URL=https://rpc.testnet.near.org
# Optional; blank uses the deterministic, deliberately gullible agent.
NEBIUS_API_KEY=
# Base: blank address shows a labeled, not-deployed mock fixture.
# Setting either address enables live, read-only Base Sepolia RPC.
BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_LEASH_BASE_ADDRESS=
# Optional server-only address override (takes precedence).
BASE_VAULT_ADDRESS=

# Optional durable persistence (server-only; never NEXT_PUBLIC).
# Without both, the app runs in explicit local-only mode and says so.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
